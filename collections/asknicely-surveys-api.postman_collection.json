        {
          "id": "6e00b7a3-b1de-4199-8c5d-98c9d7a37d5a",
          "name": "Bulk add or update contacts, optionally triggering surveys",
          "request": {
            "name": "Bulk add or update contacts, optionally triggering surveys",
            "description": {
              "content": "Asynchronous bulk import. Accepts a JSON body with a top-level `contacts` array; each contact requires `email` and may carry `name`, `segment` and any number of custom data fields (suffix `_c`), including multi-value arrays. Setting `\"obeyrules\": true` triggers surveys for eligible contacts under the Global Contact Rules. Payload limit is 6MB. Valid payloads return HTTP 201 immediately and are processed asynchronously — no per-contact result is returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "contacts",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your AskNicely account subdomain (the value in https://{domain}.asknice.ly).",
                  "type": "any",
                  "value": "{{domain}}",
                  "key": "domain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\n      \"email\": \"<email>\",\n      \"name\": \"<string>\",\n      \"segment\": \"<string>\"\n    },\n    {\n      \"email\": \"<email>\",\n      \"name\": \"<string>\",\n      \"segment\": \"<string>\"\n    }\n  ],\n  \"obeyrules\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
